[Unit]
Description=G1 Onboard Audio Driver (Microphone + Speaker)
After=pulseaudio.service network-online.target
Wants=pulseaudio.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 __INSTALL_DIR__/g1_audio_driver.py
ExecStopPost=/usr/bin/bash -c 'rm -f /tmp/g1_mic.pipe /tmp/g1_spk.pipe'
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=10
Environment=PYTHONUNBUFFERED=1
Environment=UNITREE_SDK_PATH=__UNITREE_SDK_PATH__
Environment=G1_DDS_INTERFACE=__DDS_INTERFACE__
# ── Latency tuning — Run 5 config (lowest verified stable) ───────────────────
# Speaker PlayStream max piece: 1600 bytes = 50ms
Environment=G1_PLAYSTREAM_CHUNK_BYTES=1600
# Early-flush floor: send as soon as 320 bytes (10ms) are buffered and the
# pipe is empty — removes accumulation delay
Environment=G1_PLAYSTREAM_MIN_CHUNK_BYTES=320
# Speaker FIFO pipe buffer: 2048 bytes = 64ms
Environment=G1_SPK_PIPE_BUF_SIZE=2048
# PulseAudio pipe-sink fragment/buffer target: 10ms fragments
Environment=G1_PA_SINK_LATENCY_MSEC=10

# ── Experimental: more aggressive (uncomment to try — watch logs for
#    "PlayStream rejected" and listen for glitches; revert if unstable) ──────
#Environment=G1_PLAYSTREAM_MIN_CHUNK_BYTES=160
#Environment=G1_PA_SINK_LATENCY_MSEC=5

# ── Mic tuning ───────────────────────────────────────────────────────────────
#Environment=G1_MIC_PIPE_BUF_SIZE=8192
#Environment=G1_MIC_PENDING_CAP=5120
# ── Silence gate tuning ──────────────────────────────────────────────────────
#Environment=G1_SILENCE_RMS_THRESHOLD=100
#Environment=G1_SILENCE_GATE_SECS=0.3
# Give the driver time to clean up PA modules on stop
TimeoutStopSec=10
# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=g1-audio-driver

[Install]
WantedBy=default.target
