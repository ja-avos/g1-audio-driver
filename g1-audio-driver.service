[Unit]
Description=G1 Onboard Audio Driver (Microphone + Speaker)
After=pulseaudio.service network-online.target
Wants=pulseaudio.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 __INSTALL_DIR__/g1_audio_driver.py
ExecStopPost=/usr/bin/bash -c 'rm -f /tmp/g1_mic.pipe /tmp/g1_spk.pipe'
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=10
Environment=PYTHONUNBUFFERED=1
Environment=UNITREE_SDK_PATH=__UNITREE_SDK_PATH__
Environment=G1_DDS_INTERFACE=__DDS_INTERFACE__
# ── Latency tuning (uncomment to override defaults) ──────────────────────────
# Speaker PlayStream chunk: 6400=200ms (default), 3200=100ms, 1600=50ms
#Environment=G1_PLAYSTREAM_CHUNK_BYTES=3200
# Early-flush floor in bytes (320=10ms): send partial pieces when the pipe is
# empty instead of waiting to fill a full chunk — cuts accumulation delay
#Environment=G1_PLAYSTREAM_MIN_CHUNK_BYTES=320
# Speaker FIFO pipe buffer in bytes (default 8192)
#Environment=G1_SPK_PIPE_BUF_SIZE=4096
# PulseAudio pipe-sink buffering target in ms (converted to fragment_size/buffer_size)
#Environment=G1_PA_SINK_LATENCY_MSEC=20
# ── Mic tuning ───────────────────────────────────────────────────────────────
#Environment=G1_MIC_PIPE_BUF_SIZE=8192
#Environment=G1_MIC_PENDING_CAP=5120
# ── Silence gate tuning ──────────────────────────────────────────────────────
#Environment=G1_SILENCE_RMS_THRESHOLD=100
#Environment=G1_SILENCE_GATE_SECS=0.3
# Give the driver time to clean up PA modules on stop
TimeoutStopSec=10
# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=g1-audio-driver

[Install]
WantedBy=default.target
